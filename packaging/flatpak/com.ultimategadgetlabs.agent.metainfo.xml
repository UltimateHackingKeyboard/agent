<component type="desktop-application">
  <id>com.ultimategadgetlabs.agent</id>

  <name>UHK Agent</name>
  <summary>Configure the Ultimate Hacking Keyboard</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>

  <developer id="com.ultimategadgetlabs">
    <name>Ultimate Gadget Laboratories</name>
  </developer>

  <description>
    <p>
      Agent is the configuration application of the Ultimate Hacking Keyboard. It lets
      you remap keys, create layers, assign macros, set up the modules and update the
      firmware of your keyboard.
    </p>
    <p>
      A UHK connected over USB is required: Agent is the tool that talks to the keyboard
      and writes your configuration to it.
    </p>
  </description>

  <launchable type="desktop-id">com.ultimategadgetlabs.agent.desktop</launchable>

  <url type="homepage">https://ultimatehackingkeyboard.com</url>
  <url type="bugtracker">https://github.com/UltimateHackingKeyboard/agent/issues</url>
